# /etc/systemd/system/kiln-server.service
[Unit]
Description=Kiln server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=kiln
ExecStart=/usr/local/bin/kiln-server --env-file /etc/kiln/server.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
