# kiln-server 配置（kiln-server --env-file /path/to/server.env）。权限建议 600。

# 外部访问地址：GitHub webhook、Runner、Dashboard 都用它
KILN_PUBLIC_URL=https://kiln.example.com
KILN_LISTEN=127.0.0.1:8080
KILN_DATABASE_URL=postgres://kiln@127.0.0.1:5432/kiln?sslmode=disable
# CAS 对象、日志（v0 存在本地磁盘）
KILN_DATA_DIR=/Users/YOU/kiln-server/data

# 管理 token：kiln CLI 和 Dashboard 登录使用。生成：openssl rand -hex 24
KILN_ADMIN_TOKEN=
# 主密钥：加密 secret，丢失后已保存的 secret 无法解密。生成：openssl rand -hex 32
KILN_MASTER_KEY=

# GitHub App（docs/DEPLOY.md 第 3 节）
KILN_GITHUB_APP_ID=
KILN_GITHUB_PRIVATE_KEY_FILE=/Users/YOU/kiln-server/github-app.pem
KILN_GITHUB_WEBHOOK_SECRET=
# 允许安装 App 的账号（你的 GitHub 登录名），其他账号的安装会被自动卸载
# 下面三处账号/仓库都是占位符，必须换成你自己的值，照抄会让安装被自动卸载
KILN_ALLOWED_ACCOUNTS=your-github-login

# 可选：用 GitHub 账号登录 Dashboard（App 设置页中的 Client ID / Client secret）
# KILN_GITHUB_CLIENT_ID=
# KILN_GITHUB_CLIENT_SECRET=
# KILN_ADMINS=your-github-login
# KILN_USERS=

# 可选：Runner 租约时长（默认 60s）
# KILN_LEASE_TTL=60s
# 可选：周期对账（docs/PLAN.md #7.3）。默认关闭：Kiln 只按 webhook 事件工作，没有事件时不向 GitHub 发请求，
# 也不会自动发现没有送达的事件，需要时在 Dashboard 仓库页点"补对账"或运行 kiln repo reconcile owner/name。
# 开启时两项都要设置，范围写仓库全名（逗号分隔），* 表示全部仓库
# KILN_RECONCILE_INTERVAL=15m
# KILN_RECONCILE_REPOS=owner/repo
# 可选：保留策略（docs/PLAN.md #10.3）。run 结束超过这个时间后，Server 清理它的日志、产物、缓存等过程数据，
# 只保留结果（状态、耗时、原因、退出码）。写成 12h 或 7d，至少 1h，默认 12h
# KILN_RETENTION=12h
# 日志：KILN_DEBUG=1 输出调试日志；KILN_LOG_FORMAT=json 输出 JSON 日志（默认 text）
# KILN_DEBUG=
# KILN_LOG_FORMAT=text
# 可选：日志写到这个目录中按天切分的 kiln-server-<日期>.log，只保留最近 7 天（默认写到 stderr；
# 用 docker compose 部署时不需要，日志由 docker 按大小轮转）
# KILN_LOG_DIR=/Users/YOU/kiln-server/logs
# 仅测试或 GitHub Enterprise 时需要
# KILN_GITHUB_API_URL=
# KILN_GITHUB_UPLOAD_URL=
